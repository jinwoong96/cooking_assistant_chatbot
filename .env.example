# 식품안전나라 OpenAPI 인증키. https://various.foodsafetykorea.go.kr 에서 회원가입 후
# "OpenAPI 신청" 메뉴에서 발급받으세요. 발급 전에는 "sample" 값으로 동작 확인만 가능하고,
# 실제 전체 레시피(1000건+) 수집에는 개인 키가 필요합니다.
FOOD_SAFETY_API_KEY=sample

DB_PATH=data/app.db
CHROMA_DB_PATH=data/chroma_db
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 재료 최저가 조회는 별도 API 키가 필요 없습니다 — 에누리(enuri.com) 검색결과 페이지를
# 직접 스크래핑합니다 (pricing/enuri_client.py 참고). 네이버쇼핑/쿠팡파트너스/11번가
# API를 모두 검토했으나 서비스종료·매출조건·사업자등록 요구로 개인이 쓸 수 없어 전환함.

# 로컬 LLM (Ollama). 사전에 `ollama pull qwen3:14b`로 모델을 받아두고
# Ollama 앱/서비스가 떠 있어야 합니다 (기본 포트 11434).
LLM_MODEL=ollama_chat/qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434
