# 식품안전나라 OpenAPI 인증키. https://various.foodsafetykorea.go.kr 에서 회원가입 후
# "OpenAPI 신청" 메뉴에서 발급받으세요. 발급 전에는 "sample" 값으로 동작 확인만 가능하고,
# 실제 전체 레시피(1000건+) 수집에는 개인 키가 필요합니다.
FOOD_SAFETY_API_KEY=sample

DB_PATH=data/app.db
CHROMA_DB_PATH=data/chroma_db
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 11번가 오픈API(openapi.11st.co.kr) 로그인 후 "API 신청" 메뉴에서 발급.
# 재료 최저가 조회에 사용합니다. (네이버쇼핑 검색 API는 2026-07-31부로 서비스 종료되어 대체함)
ELEVEN_ST_API_KEY=
