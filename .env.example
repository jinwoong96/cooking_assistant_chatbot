# 식품안전나라 OpenAPI 인증키. https://various.foodsafetykorea.go.kr 에서 회원가입 후
# "OpenAPI 신청" 메뉴에서 발급받으세요. 발급 전에는 "sample" 값으로 동작 확인만 가능하고,
# 실제 전체 레시피(1000건+) 수집에는 개인 키가 필요합니다.
FOOD_SAFETY_API_KEY=sample

DB_PATH=data/app.db
CHROMA_DB_PATH=data/chroma_db
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 재료 최저가 조회는 별도 API 키가 필요 없습니다 — 에누리(enuri.com) 검색결과 페이지를
# 직접 스크래핑합니다 (pricing/enuri_client.py 참고). 네이버쇼핑/쿠팡파트너스/11번가
# API를 모두 검토했으나 서비스종료·매출조건·사업자등록 요구로 개인이 쓸 수 없어 전환함.

# 로컬 LLM (Ollama). 사전에 `ollama pull qwen3:14b`로 모델을 받아두고
# Ollama 앱/서비스가 떠 있어야 합니다 (기본 포트 11434).
LLM_MODEL=ollama_chat/qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434

# 비워두면(기본값) 로그인 없이 실행됩니다 — 로컬 전용일 때는 이대로 두세요.
# Tailscale 등으로 외부에서 접속 가능하게 열 때만 비밀번호를 채워서 로그인을 요구하세요.
APP_USERNAME=me
APP_PASSWORD=

# 음성 입력(STT, faster-whisper CPU). small / medium / large-v3-turbo — 앱 화면에서도 바꿀 수 있음.
# STT_MODEL_DIR을 speech_to_text 프로젝트의 모델 폴더로 지정하면 다시 받지 않아도 됨.
STT_MODEL=medium
STT_MODEL_DIR=data/models/whisper
# STT_MODEL_DIR=C:/Project_Files/speech_to_text/models/hf

# 음성 출력(TTS, Supertonic CPU). 모델: supertonic-2 | supertonic-3, 음성: F1~F5, M1~M5
TTS_MODEL=supertonic-2
TTS_VOICE=F1
# 음성 속도 기본값 (1.05 = 모델 기본, 클수록 빠름). 화면 슬라이더로도 바꿀 수 있음
TTS_SPEED=1.05
